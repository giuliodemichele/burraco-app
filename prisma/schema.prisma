generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") 
}

model Player {
  id        String       @id @default(cuid())
  name      String
  avatarUrl String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  teams     TeamPlayer[]
}

model Match {
  id            String      @id @default(cuid())
  status        MatchStatus @default(ONGOING)
  targetScore   Int         @default(2005)
  winningTeamId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  teams         Team[]
  rounds        Round[]
}

enum MatchStatus {
  ONGOING
  COMPLETED
}

model Team {
  id        String       @id @default(cuid())
  matchId   String
  match     Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamIndex Int          // 1 for Team 1, 2 for Team 2
  name      String
  
  players   TeamPlayer[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([matchId, teamIndex])
}

model TeamPlayer {
  teamId   String
  playerId String
  
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
}

model Round {
  id          String   @id @default(cuid())
  matchId     String
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  
  roundNumber Int
  team1Score  Int
  team2Score  Int

  createdAt   DateTime @default(now())

  @@unique([matchId, roundNumber])
}
